# Brandcart frontend production example
# Copy to brandcart-web/.env.local for production builds.

# Must point to your HTTPS API origin
# Example:
# VITE_API_BASE_URL=https://api.brandcart.com
VITE_API_BASE_URL=https://api.brandcart.com

# Notes:
# - This must match backend CORS and cookie settings.
# - If frontend and backend are on different subdomains, backend cookies should
#   usually use AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAMESITE=none.
