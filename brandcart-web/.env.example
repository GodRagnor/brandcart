# Brandcart Frontend Configuration
# Copy this file to .env.local and update the values

# API Base URL - must use HTTPS in production
# Development: http://localhost:8000
# Production: https://api.brandcart.com
# This must match backend CORS and cookie configuration.
# Leave blank in local dev to use the Vite /api proxy.
VITE_API_BASE_URL=

# SECURITY CHECKLIST:
# ✓ Always use HTTPS in production
# ✓ Never commit .env.local to git
# ✓ Auth tokens are managed securely via library
# ✓ Card data is NOT stored locally
# ✓ CSRF protection is enabled
# ✓ Rate limiting is enforced on sensitive endpoints
# ✓ Input validation is performed on all forms
# ✓ Security headers are configured
