# Brandcart backend environment example
# Copy to backend/.env and replace placeholder values before running in production.

# Core
ENV=development
MONGODB_URI=mongodb://localhost:27017/brandcart
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
OTP_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DELIVERY_WEBHOOK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_PHONE=9999999999
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session TTLs
ACCESS_TOKEN_DAYS=30
BUYER_ACCESS_TOKEN_MINUTES=60
BUYER_REFRESH_TOKEN_DAYS=30
SELLER_ACCESS_TOKEN_MINUTES=30
SELLER_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Buyer payments via Razorpay
RAZORPAY_KEY_ID=CHANGE_THIS_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_THIS_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_THIS_RAZORPAY_WEBHOOK_SECRET

# Seller payouts via RazorpayX
PAYOUT_PROVIDER=razorpayx
RAZORPAYX_KEY_ID=CHANGE_THIS_RAZORPAYX_KEY_ID
RAZORPAYX_KEY_SECRET=CHANGE_THIS_RAZORPAYX_KEY_SECRET
RAZORPAYX_ACCOUNT_NUMBER=CHANGE_THIS_SOURCE_ACCOUNT_NUMBER
RAZORPAYX_WEBHOOK_SECRET=CHANGE_THIS_RAZORPAYX_WEBHOOK_SECRET
EMERGENCY_PAYOUT_FEE_PERCENT=1.5
EMERGENCY_PAYOUT_FEE_FLAT=5

# Seller bank data encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_DATA_ENCRYPTION_KEY=CHANGE_THIS_FERNET_KEY

# Product media
CLOUDINARY_CLOUD_NAME=CHANGE_THIS_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_THIS_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CHANGE_THIS_CLOUDINARY_API_SECRET

# OTP delivery
# Development: OTP_DEV_MODE=true and SMS_PROVIDER=none
# Production: OTP_DEV_MODE=false and provide Twilio credentials
OTP_DEV_MODE=true
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Optional email OTP / notifications
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Commerce policy
MAX_COD_ORDER_VALUE=25000
MAX_DAILY_COD_ORDERS=20
COD_MIN_SECURITY_BALANCE=0
COD_RTO_PENALTY=0
MAX_NEGATIVE_WALLET=-5000
RETURN_WINDOW_DAYS=7
SELLER_ACTION_HOURS=48
