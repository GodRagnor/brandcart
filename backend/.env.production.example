# Brandcart backend production example
# Copy values into backend/.env for your production deployment.

# Core
ENV=production
MONGODB_URI=CHANGE_THIS_PRODUCTION_MONGODB_URI
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
OTP_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DELIVERY_WEBHOOK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_PHONE=9999999999

# Frontend origin(s) allowed to call the API
# Example:
# CORS_ALLOWED_ORIGINS=https://brandcart.com,https://www.brandcart.com
CORS_ALLOWED_ORIGINS=https://brandcart.com

# Session TTLs
ACCESS_TOKEN_DAYS=30
BUYER_ACCESS_TOKEN_MINUTES=60
BUYER_REFRESH_TOKEN_DAYS=30
SELLER_ACCESS_TOKEN_MINUTES=30
SELLER_REFRESH_TOKEN_DAYS=7

# Cookie auth
# Same-site frontend + API:
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=
#
# Frontend on one subdomain and API on another subdomain:
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_DOMAIN=.brandcart.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Buyer payments via Razorpay (live keys only)
RAZORPAY_KEY_ID=CHANGE_THIS_RAZORPAY_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_THIS_RAZORPAY_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_THIS_RAZORPAY_WEBHOOK_SECRET

# Seller payouts via RazorpayX
PAYOUT_PROVIDER=razorpayx
RAZORPAYX_KEY_ID=CHANGE_THIS_RAZORPAYX_LIVE_KEY_ID
RAZORPAYX_KEY_SECRET=CHANGE_THIS_RAZORPAYX_LIVE_KEY_SECRET
RAZORPAYX_ACCOUNT_NUMBER=CHANGE_THIS_SOURCE_ACCOUNT_NUMBER
RAZORPAYX_WEBHOOK_SECRET=CHANGE_THIS_RAZORPAYX_WEBHOOK_SECRET
EMERGENCY_PAYOUT_FEE_PERCENT=1.5
EMERGENCY_PAYOUT_FEE_FLAT=5

# Seller bank data encryption
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_DATA_ENCRYPTION_KEY=CHANGE_THIS_FERNET_KEY

# Product media
CLOUDINARY_CLOUD_NAME=CHANGE_THIS_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_THIS_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CHANGE_THIS_CLOUDINARY_API_SECRET

# OTP delivery (live)
OTP_DEV_MODE=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_THIS_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_THIS_TWILIO_AUTH_TOKEN
TWILIO_FROM_PHONE=+1234567890

# Optional email OTP / fallback notifications
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Commerce policy
MAX_COD_ORDER_VALUE=25000
MAX_DAILY_COD_ORDERS=20
COD_MIN_SECURITY_BALANCE=0
COD_RTO_PENALTY=0
MAX_NEGATIVE_WALLET=-5000
RETURN_WINDOW_DAYS=7
SELLER_ACTION_HOURS=48
